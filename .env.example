# Salin ke .env lalu isi. File .env TIDAK boleh di-commit (sudah ada di .gitignore).
# Baris dengan nilai kosong (KEY=) dianggap tidak di-set, jadi nilai default dipakai.

# --- Node CointMU (hanya method baca yang dipanggil) ---
# WAJIB. URL RPC HTTP node, tanpa default. Di Docker jangan 127.0.0.1 (itu container sendiri).
RPC_URL=http://<GETH_HOST>:<PORT>
RPC_TIMEOUT_MS=5000
# Bot berhenti saat start kalau node melaporkan chain ID lain.
EXPECTED_CHAIN_ID=1912

# --- Telegram ---
# WAJIB (kecuali DRY_RUN=true). Token dari @BotFather. Jangan ditempel ke chat/issue mana pun.
BOT_TOKEN=

# Semua di bawah ini OPSIONAL. Kalau kosong, diatur dari Telegram:
#   /claim (admin pertama), /setchat, /setalert, /addadmin.
# Kalau diisi, nilai env MENANG dan tidak bisa diubah dari chat.
# Chat/channel pengumuman block, contoh -1001234567890 (channel hanya bisa lewat env)
CHAT_ID=
# Chat untuk alert kesehatan node (kosong + belum /setalert = chat pribadi tiap admin)
ALERT_CHAT_ID=
# Admin dari env (dipisah koma). Mengisi ini mematikan kode klaim; admin env tidak bisa
# dihapus lewat /removeadmin.
ALLOWED_USER_IDS=
# Opsional: semua anggota chat ini boleh memakai /status /last /top (selain chat pengumuman)
ALLOWED_CHAT_IDS=
# Jeda minimal antar command/tombol per user (non-admin), dalam detik
COMMAND_COOLDOWN_SECONDS=5
# Maksimal balasan command yang menunggu di antrean (lebih = toast "lagi ramai")
COMMAND_QUEUE_MAX=20
# Maksimal balasan command per menit per grup (sisanya untuk digest & edit status)
COMMAND_REPLIES_PER_MINUTE=8
# Tampilan sama (status/last/top) tidak dikirim ulang ke chat yang sama dalam N detik
DUPLICATE_WINDOW_SECONDS=10

# --- Interval & batas ---
POLL_INTERVAL_MS=1000
SEND_INTERVAL_MS=10000
MIN_SEND_GAP_MS=3000
CONFIRMATIONS=6
HASHRATE_WINDOW=20
# Saat DB kosong: simpan N block terakhir diam-diam (statistik saja, tidak diumumkan)
START_BACKFILL=50

# --- Health monitor ---
MIN_PEERS=1
# 0 = matikan alert "head tidak naik" (mis. saat maintenance)
STALL_MINUTES=5
RPC_FAIL_THRESHOLD=10
ALERT_COOLDOWN_MINUTES=10
# Opsional, mis. https://hc-ping.com/<uuid> — di-ping tiap 60 detik selama collector sehat
HEARTBEAT_URL=

# --- Discord #block-update (opsional) ---
# Webhook channel Discord: Edit Channel > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# RAHASIA: siapa pun yang memegang URL ini bisa memposting ke channel. Kosong = Discord mati.
# Hanya block yang sudah final yang diposting; alert kesehatan tetap hanya ke Telegram.
DISCORD_WEBHOOK_BLOCK_UPDATE=

# --- Penyimpanan & lain-lain ---
# Default ./data/bot.db (atau ./data/dry-run.db saat DRY_RUN=true). Di Docker: /data/bot.db
DB_PATH=
DATA_RETENTION_DAYS=30
# true = pesan dicetak ke konsol, tidak ada yang dikirim ke Telegram
DRY_RUN=false
# debug | info | warn | error
LOG_LEVEL=info
